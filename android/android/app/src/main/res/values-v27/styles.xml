<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phones with a notch or punch-hole. index.html already sets
         viewport-fit=cover, so the page expects the full display; shortEdges
         lets it have it instead of reserving a black strip beside the cutout.
         Kept in values-v27 because the attribute does not exist before API 27. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
